       IDENTIFICATION DIVISION.
       PROGRAM-ID. ACCT01.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INVFILE ASSIGN TO INVDD
               ORGANIZATION IS INDEXED
               RECORD KEY IS INV-KEY.
           SELECT RPTFILE ASSIGN TO RPTOUT.
       DATA DIVISION.
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN INPUT INVFILE.
           OPEN OUTPUT RPTFILE.
           CALL 'ACCT9M' USING WS-COMM-AREA.
           CLOSE INVFILE RPTFILE.
           STOP RUN.
