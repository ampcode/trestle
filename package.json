{
  "name": "trestle",
  "version": "0.1.0",
  "description": "Knowledge graph harness for code migration: fork this repo, pin your estates as submodules under corpora/, extract facts, resolve a typed evidence graph, and serve it to coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "trestle": "./bin/trestle.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:viz": "node src/viz/upstream/build.js",
    "prelint": "node .agents/skills/installing-anti-slop/scripts/install.mjs --force",
    "lint": "oxlint .",
    "test": "npm run build:viz && node --test 'tests/*.test.ts'",
    "typecheck": "tsc --noEmit && node src/viz/upstream/build.js --check"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.19.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^24.0.0",
    "oxlint": "1.81.0",
    "typescript": "^5.8.0"
  }
}
